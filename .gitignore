# Haipeng CRM monorepo: keep source in Git, exclude local/generated data.

# Environment files and secrets
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.crt

# Node.js dependencies and caches
node_modules/
**/node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.pnp.*

# Frontend build and tooling output
dist/
**/dist/
dist-ssr/
**/dist-ssr/
build/
**/build/
coverage/
**/coverage/
.vite/
**/.vite/
*.tsbuildinfo
.eslintcache

# Python virtual environments
.venv/
**/.venv/
venv/
**/venv/
env/
ENV/

# Python caches and test output
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local databases and runtime uploads
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite3-journal
**/uploads/
**/upload/
media/
**/media/

# Logs and runtime files
logs/
**/logs/
*.log
*.err
*.pid
*.pid.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test and browser artefacts
test-results/
**/test-results/
playwright-report/
**/playwright-report/
screenshots/
**/screenshots/

# IDE, editor and operating-system files
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*~
.DS_Store
Thumbs.db
Desktop.ini

